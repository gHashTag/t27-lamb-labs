read_verilog -sv attn_token.v token_rate_probe.v
synth_xilinx -family xc7 -nodsp -nosrl -nolutram -nocarry -top token_rate_probe -flatten -run begin:map_luts
opt_expr -mux_undef -noclkinv
abc -lut 2
clean
techmap -map +/xilinx/ff_map.v
techmap -map +/xilinx/lut_map.v -map +/xilinx/cells_map.v -D LUT_WIDTH=46
xilinx_dffopt -lut4
opt_lut_ins -tech xilinx
synth_xilinx -family xc7 -nodsp -nosrl -nolutram -nocarry -top token_rate_probe -flatten -run finalize:end
stat
write_json trp.json
