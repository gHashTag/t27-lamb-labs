; Variance Ingest Spec
; Source of truth for GODMODE variance evidence ingestion
; phi^2 + 1/phi^2 = 3 | TRINITY

module GODMODE_VarianceIngest;

pub const REQUIRES_FIVE_CYCLE_ONE_RUNS : bool = true;
pub const CLAIM_TRANSITION_PARTIAL_TO_MEASURED : bool = true;
pub const ALL_ARTIFACTS_HASHED : bool = true;

pub fn requires_five_cycle_one_runs(cycle_one_count: int) -> bool {
    return cycle_one_count == 5;
}

pub fn claim_transition_partial_to_measured(accepted: bool, claim_status: str) -> bool {
    if (accepted) {
        return claim_status == "MEASURED";
    }
    return claim_status == "PARTIAL";
}

pub fn all_artifacts_hashed(accepted: bool, all_hashed: bool) -> bool {
    if (accepted) {
        return all_hashed;
    }
    return true;
}

test requires_five_cycle_one_runs_test {
    assert requires_five_cycle_one_runs(5) == true;
    assert requires_five_cycle_one_runs(4) == false;
    assert requires_five_cycle_one_runs(6) == false;
    assert requires_five_cycle_one_runs(0) == false;
}

test claim_transition_partial_to_measured_test {
    assert claim_transition_partial_to_measured(true, "MEASURED") == true;
    assert claim_transition_partial_to_measured(true, "PARTIAL") == false;
    assert claim_transition_partial_to_measured(true, "NOT_MEASURED") == false;
    assert claim_transition_partial_to_measured(false, "PARTIAL") == true;
    assert claim_transition_partial_to_measured(false, "MEASURED") == false;
}

test all_artifacts_hashed_test {
    assert all_artifacts_hashed(true, true) == true;
    assert all_artifacts_hashed(true, false) == false;
    assert all_artifacts_hashed(false, false) == true;
}
