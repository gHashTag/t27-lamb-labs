module BestimateStat;
// B-ESTIMATE reduction for the yosys `stat` artifact (thin-glue law: the parsing
// and reduction logic lives HERE, in .t27; shell only captures bytes).
//
// Input: raw output of `yosys ... synth_xilinx -family xc7 -top <m> -flatten; stat`.
// Output: the B-ESTIMATE headline as JSON on stdout, label ESTIMATE per the
// lab's honesty vocabulary (see README "Evidence status").
//
// Cell-line grammar (yosys 0.33 stat): a line of leading spaces, an UPPER_CASE
// cell name, spaces, a decimal count, end of line. Prose lines ("Number of
// wires: ...") are excluded because their first word is lowercase. Several
// designs in one file sum across their blocks.
// Classes: LUT* -> LUT sites; FD* -> flip-flops; DSP48* -> DSP blocks;
// RAMB* -> BRAM blocks; everything else counts toward `cells` only.
// Refusal contract: zero recognized cell lines -> false (and main exits 1).
// Golden vectors: verbatim stat artifacts committed at
// fpga/stack/results/ (counter, fir4, comb_ternary_dot_top), captured from the
// givel-vps yosys 0.33 runs.

fn has_prefix(s: []const u8, p: []const u8) -> bool {
    if (s.len < p.len) { return false; }
    var i : usize = 0;
    while (i < p.len) {
        if (s[i] != p[i]) { return false; }
        i = i + 1;
    }
    return true;
}

// Classify one cell name: 1 LUT site, 2 flip-flop, 3 DSP, 4 BRAM, 0 other.
fn classify(name: []const u8) -> u32 {
    if (has_prefix(name, "LUT")) { return 1; }
    if (name.len >= 2 and name[0] == 70 and name[1] == 68) { return 2; }
    if (has_prefix(name, "DSP48")) { return 3; }
    if (has_prefix(name, "RAMB")) { return 4; }
    return 0;
}

fn is_name_byte(b: u8) -> bool {
    if (b >= 65 and b <= 90) { return true; }
    if (b >= 48 and b <= 57) { return true; }
    if (b == 95 or b == 36) { return true; }
    return false;
}

// Single forward pass over the stat text; never moves the cursor backwards.
// Writes the headline counts through out-pointers; false = refused input.
fn bestimate(text: []const u8, out_lut: *u32, out_ff: *u32, out_dsp: *u32,
             out_bram: *u32, out_cells: *u32) -> bool {
    var lut : u32 = 0;
    var ff : u32 = 0;
    var dsp : u32 = 0;
    var bram : u32 = 0;
    var cells : u32 = 0;
    var n : usize = text.len;
    var i : usize = 0;
    while (i < n) {
        if (text[i] == 10) {
            i = i + 1;
        } else if (text[i] == 32 or text[i] == 9) {
            while (i < n and (text[i] == 32 or text[i] == 9)) { i = i + 1; }
            var ns : usize = i;
            while (i < n and is_name_byte(text[i])) { i = i + 1; }
            var ne : usize = i;
            if (ne > ns) {
                while (i < n and (text[i] == 32 or text[i] == 9)) { i = i + 1; }
                var count : u32 = 0;
                var digits : usize = 0;
                while (i < n and text[i] >= 48 and text[i] <= 57) {
                    count = count * 10 + @as(u32, text[i] - 48);
                    digits = digits + 1;
                    i = i + 1;
                }
                while (i < n and text[i] == 32) { i = i + 1; }
                if (digits > 0 and (i == n or text[i] == 10)) {
                    cells = cells + count;
                    var k : u32 = classify(text[ns..ne]);
                    if (k == 1) { lut = lut + count; }
                    if (k == 2) { ff = ff + count; }
                    if (k == 3) { dsp = dsp + count; }
                    if (k == 4) { bram = bram + count; }
                }
            }
            while (i < n and text[i] != 10) { i = i + 1; }
        } else {
            while (i < n and text[i] != 10) { i = i + 1; }
        }
    }
    if (cells == 0) { return false; }
    out_lut.* = lut;
    out_ff.* = ff;
    out_dsp.* = dsp;
    out_bram.* = bram;
    out_cells.* = cells;
    return true;
}

// Decimal u32 to stdout.
fn write_u32(v: u32) -> void {
    var digits : [10]u8 = undefined;
    var d : usize = 0;
    var x : u32 = v;
    if (x == 0) {
        digits[0] = 48;
        d = 1;
    }
    while (x > 0) {
        digits[d] = 48 + @as(u8, @intCast(x % 10));
        d = d + 1;
        x = x / 10;
    }
    var buf : [10]u8 = undefined;
    var j : usize = 0;
    while (j < d) {
        buf[j] = digits[d - 1 - j];
        j = j + 1;
    }
    _ = std.c.write(1, @ptrCast(&buf), d);
}

fn write_seg(s: []const u8) -> void {
    _ = std.c.write(1, s.ptr, s.len);
}

var BS_IN : [65536]u8 = undefined;

// stdin: raw yosys stat text. stdout: B-ESTIMATE JSON. Exit 1 on refused input.
pub fn main() -> void {
    var len : usize = 0;
    var r : isize = 1;
    while (r > 0 and len < 65536) {
        r = std.c.read(0, BS_IN[len..65536].ptr, 65536 - len);
        if (r > 0) {
            len = len + @as(usize, @intCast(r));
        }
    }
    if (len == 0) { std.c.exit(1); }
    var lut : u32 = 0;
    var ff : u32 = 0;
    var dsp : u32 = 0;
    var bram : u32 = 0;
    var cells : u32 = 0;
    if (!bestimate(BS_IN[0..len], &lut, &ff, &dsp, &bram, &cells)) { std.c.exit(1); }
    write_seg("{\"label\":\"ESTIMATE\",\"lut\":");
    write_u32(lut);
    write_seg(",\"ff\":");
    write_u32(ff);
    write_seg(",\"dsp\":");
    write_u32(dsp);
    write_seg(",\"bram\":");
    write_u32(bram);
    write_seg(",\"cells\":");
    write_u32(cells);
    write_seg("}\n");
}

// --- golden vectors: verbatim committed stat artifacts ---

const GOLDEN_COUNTER : []const u8 = "\n3. Printing statistics.\n\n=== counter ===\n\n   Number of wires:                 44\n   Number of wire bits:            168\n   Number of public wires:           4\n   Number of public wire bits:      35\n   Number of memories:               0\n   Number of memory bits:            0\n   Number of processes:              0\n   Number of cells:                109\n     BUFG                            1\n     CARRY4                          8\n     FDRE                           32\n     IBUF                            3\n     INV                            33\n     OBUF                           32\n\n";

const GOLDEN_FIR4 : []const u8 = "\n3. Printing statistics.\n\n=== fir4 ===\n\n   Number of wires:                 71\n   Number of wire bits:            582\n   Number of public wires:          15\n   Number of public wire bits:     163\n   Number of memories:               0\n   Number of memory bits:            0\n   Number of processes:              0\n   Number of cells:                163\n     BUFG                            1\n     CARRY4                          5\n     DSP48E1                         4\n     FDRE                           34\n     IBUF                           43\n     INV                            35\n     LUT2                           17\n     OBUF                           24\n\n";

const GOLDEN_COMB : []const u8 = "\n3. Printing statistics.\n\n=== comb_ternary_dot_top ===\n\n   Number of wires:                291\n   Number of wire bits:            887\n   Number of public wires:         137\n   Number of public wire bits:     540\n   Number of memories:               0\n   Number of memory bits:            0\n   Number of processes:              0\n   Number of cells:                370\n     CARRY4                          2\n     IBUF                          108\n     LUT2                            3\n     LUT3                           13\n     LUT4                           37\n     LUT5                           16\n     LUT6                          122\n     MUXF7                          46\n     MUXF8                          15\n     OBUF                            8\n\n";

test "counter_golden_carry_chain_only" {
    var l : u32 = 0; var f : u32 = 0; var d : u32 = 0; var b : u32 = 0; var c : u32 = 0;
    var ok : u32 = 0;
    if (bestimate(GOLDEN_COUNTER, &l, &f, &d, &b, &c)) { ok = 1; }
    assert_eq(ok, 1);
    assert_eq(l, 0);
    assert_eq(f, 32);
    assert_eq(d, 0);
    assert_eq(b, 0);
    assert_eq(c, 109);
}

test "fir4_golden_four_dsp_lut2_adders" {
    var l : u32 = 0; var f : u32 = 0; var d : u32 = 0; var b : u32 = 0; var c : u32 = 0;
    var ok : u32 = 0;
    if (bestimate(GOLDEN_FIR4, &l, &f, &d, &b, &c)) { ok = 1; }
    assert_eq(ok, 1);
    assert_eq(l, 17);
    assert_eq(f, 34);
    assert_eq(d, 4);
    assert_eq(b, 0);
    assert_eq(c, 163);
}

test "comb_golden_lut_tree_no_ff" {
    var l : u32 = 0; var f : u32 = 0; var d : u32 = 0; var b : u32 = 0; var c : u32 = 0;
    var ok : u32 = 0;
    if (bestimate(GOLDEN_COMB, &l, &f, &d, &b, &c)) { ok = 1; }
    assert_eq(ok, 1);
    assert_eq(l, 191);
    assert_eq(f, 0);
    assert_eq(d, 0);
    assert_eq(b, 0);
    assert_eq(c, 370);
}

test "refuse_empty_input" {
    var l : u32 = 0; var f : u32 = 0; var d : u32 = 0; var b : u32 = 0; var c : u32 = 0;
    var refused : u32 = 0;
    if (!bestimate("", &l, &f, &d, &b, &c)) { refused = 1; }
    assert_eq(refused, 1);
}

test "refuse_prose_without_cell_lines" {
    var l : u32 = 0; var f : u32 = 0; var d : u32 = 0; var b : u32 = 0; var c : u32 = 0;
    var refused : u32 = 0;
    if (!bestimate("hello world\nTHE END\n", &l, &f, &d, &b, &c)) { refused = 1; }
    assert_eq(refused, 1);
    assert_eq(c, 0);
}
