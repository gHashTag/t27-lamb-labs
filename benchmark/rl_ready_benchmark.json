    },
    "resource_constraint": {
      "max_estimated_lcs": 13460,
      "max_lcs_fraction_of_device": 0.1,
      "rationale": "the combinational attention form measured 28,619 LCs = 21.3% of the device and was rejected; the benchmark caps candidates at 10% of the LUT fabric",
      "device_lcs": 134600,
      "note": "The combinational attention form measured 28,619 LCs = 21.3% and was rejected. The sequential form measures 455 LCs = 0.34% for the same configuration, so the cap no longer binds for any configuration in the measured sweep."
    }
  },
  "reproducible_protocol": {
    "synthesis": "yosys 0.67+post synth_xilinx -family xc7 -nodsp -nosrl -flatten",
    "measurements": [
      "estimated_lcs, luts, ffs, bram_36k, dsp48e1, carry4, muxf7, muxf8",
      "bit_exact_match_rate against the CPU golden",
      "tok_per_s (measured on the board, 5 cycle-1 runs)",
      "J_per_token = measured_W / measured_tok_per_s"
    ],
    "hash_requirements": "every candidate produces a SHA256 of its netlist, its stats log and its quality log; a result without the hash is not accepted",
    "repeat_policy": "5 cycle-1 runs per candidate; report mean, stddev and CV"
  },
