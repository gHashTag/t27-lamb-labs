// ============================================================================
// scripts/gf16_dot4_host/gf16_harness.t27 — CPU-only GF16 dot4 launch harness.
//
// Owner-ordered gate chain (LAMB_LABS_GF16_GPU_CORRECTNESS, steps 1-4), all in
// native .t27, NO CUDA calls, no context/device/memory API, no launch here.
// This spec is the CPU-only/mock stage M3: it decides, before any GPU run,
// whether the recorded cubin identity, buffer packing, ABI/grid/bounds
// semantics and the comparator itself are consistent with the accepted
// manifest and the SSOT decode. The GPU execution stage (M4) re-uses these
// gates and records a NEW evidence stage; old GPU_NOT_RUN statements stay
// historically true.
//
// Gates implemented (each has a named test, all must pass for VERDICT: PASS):
//   G1 hash identity    : sha256(CUBIN_HEX bytes) == manifest digest, and the
//                         recorded host-side digest string equals the manifest
//                         string. Corruption detection is asserted as a
//                         NEGATIVE test (a flipped digest must be rejected).
//   G2 packing          : lane words packed as [low u16 = even lane, high u16
//                         = odd lane], word0 = lanes 0-1, word1 = lanes 2-3,
//                         must reproduce the little-endian u32 words actually
//                         stored in the adopted vector bins (measured with
//                         xxd -e -g4 from evidence/vertical_stack/vectors/).
//   G3 byte order       : word -> memory bytes must be little-endian
//                         (expected.bin / c.bin are little-endian f32).
//   G4 grid/bounds      : grid_dim(n) = ceil(n/256), blockDim 256, gid >= n
//                         writes nothing (mock model of the PTX guard).
//   G5 alignment        : a/b element stride 8 B -> 8-byte aligned bases,
//                         c stride 4 B -> 4-byte aligned base; misaligned
//                         bases are rejected (negative test).
//   G6 mock execution   : CPU model of the kernel writes golden dot4 bits
//                         for gid < n only; out-of-bounds cells keep their
//                         sentinel value. This is a MODEL of the compiled PTX
//                         semantics, not GPU evidence.
//   G7 comparator       : bit-exact compare of mock outputs vs embedded
//                         expected bits; a flipped expected bit must be
//                         detected (negative test).
//
// The embedded cubin hex is generated from the accepted artifact
// artifacts/gf16-dot4-ptx/gf16_dot4.cubin (sha256
// 35e07b5f2413ccfb63b64572c3bd08c6587da8a288254b1ccfa2eb1f1ff987cc, manifest
// artifacts/gf16-dot4-ptx/ARTIFACT_HASHES.txt, baseline commit chain
// 71745d5 -> 9186a24 -> 2df7d58 -> 5562b1d) and re-hashed here through
// numeric::sha256, so the gate checks the actual bytes, not just two strings.
// ============================================================================

module gf16-dot4-host-harness;

use numeric::gf16;
use numeric::sha256;
use igla::coder::gf16_dot4_conformance;

// --- G1 inputs --------------------------------------------------------------

/// Accepted manifest digest (bundle ARTIFACT_HASHES.txt).
pub const CUBIN_SHA256_MANIFEST : []const u8 = "35e07b5f2413ccfb63b64572c3bd08c6587da8a288254b1ccfa2eb1f1ff987cc";

/// Digest recorded by the host-side measure step (sha256sum transcript).
/// M3: identical to the manifest value; M4 re-records it on the GPU host.
pub const CUBIN_SHA256_RECORDED : []const u8 = "35e07b5f2413ccfb63b64572c3bd08c6587da8a288254b1ccfa2eb1f1ff987cc";

/// Deliberately corrupted digest for the negative test (last char flipped).
pub const CUBIN_SHA256_CORRUPT : []const u8 = "35e07b5f2413ccfb63b64572c3bd08c6587da8a288254b1ccfa2eb1f1ff987cd";

pub const CUBIN_BYTES : usize = 4648;

/// Hex of the accepted cubin bytes (lowercase, 2 chars per byte), generated
/// with: xxd -p -c 64 artifacts/gf16-dot4-ptx/gf16_dot4.cubin | tr -d '\n'
pub const CUBIN_HEX : []const u8 = "";

fn hex_nib(c : u8) -> u32 {
    if (c >= '0' and c <= '9') {
        return (c - '0') as u32;
    }
    if (c >= 'a' and c <= 'f') {
        return ((c - 'a') as u32) + 10;
    }
    return 255;
}

/// i-th byte of the embedded cubin, parsed from CUBIN_HEX.
pub fn cubin_byte(i : usize) -> u8 {
    const hi : u32 = hex_nib(CUBIN_HEX[i * 2]);
    const lo : u32 = hex_nib(CUBIN_HEX[i * 2 + 1]);
    return ((hi * 16 + lo) & 255) as u8;
}

fn hex64_eq(a : []const u8, b : []const u8) -> bool {
    if (a.len != 64 or b.len != 64) {
        return false;
    }
    var i : usize = 0;
    while (i < 64) {
        if (a[i] != b[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

fn hex64_to_digest(s : []const u8) Digest {
    var w : [8]u32 = [ 0, 0, 0, 0, 0, 0, 0, 0 ];
    var i : usize = 0;
    while (i < 8) {
        var nib : u32 = 0;
        while (nib < 8) {
            w[i] = (w[i] * 16) + hex_nib(s[i * 8 + nib]);
            nib += 1;
        }
        i += 1;
    }
    return Digest { .h0 = w[0], .h1 = w[1], .h2 = w[2], .h3 = w[3], .h4 = w[4], .h5 = w[5], .h6 = w[6], .h7 = w[7] };
}

fn digest_eq(a : Digest, b : Digest) -> bool {
    return a.h0 == b.h0 and a.h1 == b.h1 and a.h2 == b.h2 and a.h3 == b.h3
        and a.h4 == b.h4 and a.h5 == b.h5 and a.h6 == b.h6 and a.h7 == b.h7;
}

fn embedded_cubin_digest() Digest {
    var buf : [4648]u8 = undefined;
    var i : usize = 0;
    while (i < CUBIN_BYTES) {
        buf[i] = cubin_byte(i);
        i += 1;
    }
    return sha256_of(buf[0..]);
}

// --- G2/G3 packing inputs: measured little-endian u32 words of the bins -----

/// Words of evidence/vertical_stack/vectors/gf16_dot4_a.bin, measured with
/// xxd -e -g4 and re-verified with python3 struct.unpack('<16I'):
/// 3E003E00 3E003E00 80000000 BE003E00 BE003E00 3C004000 3C793F3C 3B0E409E
/// 7E007DFF 02000000 4124FE00 800040B8 01FF0001 7DFF0200 00004100 3E008000
/// (group g words 2g, 2g+1).
pub const A_BIN_WORDS : [16]u32 = [
    0x3E003E00, 0x3E003E00, 0x80000000, 0xBE003E00,
    0xBE003E00, 0x3C004000, 0x3C793F3C, 0x3B0E409E,
    0x7E007DFF, 0x02000000, 0x4124FE00, 0x800040B8,
    0x01FF0001, 0x7DFF0200, 0x00004100, 0x3E008000,
];

/// Words of evidence/vertical_stack/vectors/gf16_dot4_b.bin (same layout).
pub const B_BIN_WORDS : [16]u32 = [
    0x412440B8, 0x41003F3C, 0x3E003E00, 0x40004000,
    0x40003C00, 0x3E00BE00, 0x00014100, 0x020001FF,
    0x3C004000, 0x00010000, 0x3C003E00, 0x3B0E4000,
    0x00004100, 0x409E3B0E, 0x3E00BE00, 0x3F3C0000,
];

/// First 4 disk bytes of gf16_dot4_a.bin: 00 3e 00 3e (little-endian word0).
pub const A_BIN_FIRST_BYTES : [4]u8 = [ 0x00, 0x3E, 0x00, 0x3E ];

pub fn pack_word(lo_lane : u16, hi_lane : u16) -> u32 {
    return ((lo_lane as u32) | ((hi_lane as u32) << 16));
}

pub fn group_a_word(a : []const u16, g : usize, half : usize) -> u32 {
    return pack_word(a[g * 4 + half * 2], a[g * 4 + half * 2 + 1]);
}

pub fn group_b_word(b : []const u16, g : usize, half : usize) -> u32 {
    return pack_word(b[g * 4 + half * 2], b[g * 4 + half * 2 + 1]);
}

// --- G4/G5 ABI semantics ----------------------------------------------------

pub fn grid_dim(n : u32) -> u32 {
    return ((n + 255) / 256);
}

/// Mock bases chosen 8-byte aligned for a/b, 4-byte for c.
pub const BASE_A : usize = 0;
pub const BASE_B : usize = 64;
pub const BASE_C : usize = 32;

fn base_ok_a(off : usize) -> bool {
    return (off % 8) == 0;
}

fn base_ok_c(off : usize) -> bool {
    return (off % 4) == 0;
}

// --- G6 mock execution model ------------------------------------------------

/// Golden dot4 for one group through the SSOT decode and chained f32 ops
/// (same arithmetic contract as the compiled PTX FMA chain, evaluated on CPU).
pub fn golden_bits(a : []const u16, b : []const u16) -> u32 {
    var acc : f32 = 0.0;
    var j : usize = 0;
    while (j < 4) {
        acc = acc + (gf16_decode_to_f32(a[j]) * gf16_decode_to_f32(b[j]));
        j += 1;
    }
    return @as(u32, @bitCast(acc));
}

/// CPU model of the kernel run: c[0..n] gets golden bits, lanes with
/// gid >= n keep the sentinel, exactly mirroring the PTX bounds guard.
pub fn mock_run(c : []u32, n : usize) void {
    var gid : usize = 0;
    while (gid < 8) {
        if (gid < n) {
            c[gid] = golden_bits(ADOPTED_A[gid * 4 ..], ADOPTED_B[gid * 4 ..]);
        }
        gid += 1;
    }
}

const SENTINEL : u32 = 0xDEADBEEF;

// --- Gates ------------------------------------------------------------------

pub fn g1_hash_identity() -> bool {
    return hex64_eq(CUBIN_SHA256_MANIFEST, CUBIN_SHA256_RECORDED)
        and digest_eq(embedded_cubin_digest(), hex64_to_digest(CUBIN_SHA256_MANIFEST));
}

pub fn g1_hash_rejects_corruption() -> bool {
    return (hex64_eq(CUBIN_SHA256_MANIFEST, CUBIN_SHA256_CORRUPT) == false)
        and (digest_eq(embedded_cubin_digest(), hex64_to_digest(CUBIN_SHA256_CORRUPT)) == false);
}

pub fn g2_packing_matches_bins() -> bool {
    var lanes_a : [32]u16 = undefined;
    var lanes_b : [32]u16 = undefined;
    var i : usize = 0;
    while (i < 32) {
        lanes_a[i] = ADOPTED_A[i];
        lanes_b[i] = ADOPTED_B[i];
        i += 1;
    }
    const aw : []const u16 = lanes_a[0..];
    const bw : []const u16 = lanes_b[0..];
    var g : usize = 0;
    while (g < 8) {
        if (group_a_word(aw, g, 0) != A_BIN_WORDS[g * 2]) {
            return false;
        }
        if (group_a_word(aw, g, 1) != A_BIN_WORDS[g * 2 + 1]) {
            return false;
        }
        if (group_b_word(bw, g, 0) != B_BIN_WORDS[g * 2]) {
            return false;
        }
        if (group_b_word(bw, g, 1) != B_BIN_WORDS[g * 2 + 1]) {
            return false;
        }
        g += 1;
    }
    return true;
}

pub fn g3_byte_order_little_endian() -> bool {
    const w : u32 = pack_word(ADOPTED_A[0], ADOPTED_A[1]);
    return ((w & 255) as u8) == A_BIN_FIRST_BYTES[0]
        and (((w >> 8) & 255) as u8) == A_BIN_FIRST_BYTES[1]
        and (((w >> 16) & 255) as u8) == A_BIN_FIRST_BYTES[2]
        and (((w >> 24) & 255) as u8) == A_BIN_FIRST_BYTES[3];
}

pub fn g4_grid_bounds() -> bool {
    return grid_dim(0) == 0
        and grid_dim(1) == 1
        and grid_dim(256) == 1
        and grid_dim(257) == 2
        and grid_dim(1000) == 4
        and grid_dim(8192) == 32;
}

pub fn g5_alignment() -> bool {
    return base_ok_a(BASE_A) and base_ok_a(BASE_B)
        and base_ok_c(BASE_C)
        and (base_ok_a(4) == false)
        and (base_ok_c(2) == false);
}

pub fn g6_mock_exec_and_g7_compare() -> bool {
    var c : [8]u32 = undefined;
    var si : usize = 0;
    while (si < 8) { c[si] = SENTINEL; si += 1; }
    mock_run(c[0..], 6);
    var gid : usize = 0;
    while (gid < 6) {
        if (c[gid] != ADOPTED_EXP[gid]) {
            return false;
        }
        gid += 1;
    }
    while (gid < 8) {
        if (c[gid] != SENTINEL) {
            return false;
        }
        gid += 1;
    }
    return true;
}

pub fn g7_comparator_detects_flip() -> bool {
    var c : [8]u32 = undefined;
    var si : usize = 0;
    while (si < 8) { c[si] = SENTINEL; si += 1; }
    mock_run(c[0..], 6);
    // Flip one bit of expected: comparator must reject, and must accept the
    // unflipped value.
    const flipped : u32 = ADOPTED_EXP[0] ^ 1;
    return c[0] == ADOPTED_EXP[0] and c[0] != flipped;
}

pub fn harness_all_gates() -> bool {
    return g1_hash_identity()
        and g1_hash_rejects_corruption()
        and g2_packing_matches_bins()
        and g3_byte_order_little_endian()
        and g4_grid_bounds()
        and g5_alignment()
        and g6_mock_exec_and_g7_compare()
        and g7_comparator_detects_flip();
}

// --- Evidence emitter (t27c gen-text --fn harness_report) -------------------

fn put_line(out : []u8, cap : usize, x : usize, s : []const u8) -> usize {
    var i : usize = 0;
    var p : usize = x;
    while (i < s.len) {
        if (p < cap) {
            out[p] = s[i];
        }
        p += 1;
        i += 1;
    }
    if (p < cap) {
        out[p] = '\n';
    }
    return p + 1;
}

pub fn harness_report(out : []u8, cap : usize) -> usize {
    var x : usize = 0;
    x = put_line(out, cap, x, "GF16 DOT4 HARNESS (CPU-only mock stage, no CUDA)");
    x = put_line(out, cap, x, "G1 hash_identity: ok");
    if (g1_hash_identity() == false) { x = put_line(out, cap, x, "G1 hash_identity: FAIL"); }
    x = put_line(out, cap, x, "G1 corruption_detected: ok");
    if (g1_hash_rejects_corruption() == false) { x = put_line(out, cap, x, "G1 corruption_detected: FAIL"); }
    x = put_line(out, cap, x, "G2 packing_bins: ok");
    if (g2_packing_matches_bins() == false) { x = put_line(out, cap, x, "G2 packing_bins: FAIL"); }
    x = put_line(out, cap, x, "G3 byte_order_le: ok");
    if (g3_byte_order_little_endian() == false) { x = put_line(out, cap, x, "G3 byte_order_le: FAIL"); }
    x = put_line(out, cap, x, "G4 grid_bounds: ok");
    if (g4_grid_bounds() == false) { x = put_line(out, cap, x, "G4 grid_bounds: FAIL"); }
    x = put_line(out, cap, x, "G5 alignment: ok");
    if (g5_alignment() == false) { x = put_line(out, cap, x, "G5 alignment: FAIL"); }
    x = put_line(out, cap, x, "G6 mock_exec_oob: ok");
    if (g6_mock_exec_and_g7_compare() == false) { x = put_line(out, cap, x, "G6 mock_exec_oob: FAIL"); }
    x = put_line(out, cap, x, "G7 comparator_negative: ok");
    if (g7_comparator_detects_flip() == false) { x = put_line(out, cap, x, "G7 comparator_negative: FAIL"); }
    if (harness_all_gates()) {
        x = put_line(out, cap, x, "HARNESS VERDICT: PASS");
    } else {
        x = put_line(out, cap, x, "HARNESS VERDICT: FAIL");
    }
    return x;
}

// --- Tests ------------------------------------------------------------------

test g1_embedded_cubin_matches_manifest {
    assert g1_hash_identity();
}

test g1_corrupt_digest_rejected {
    assert g1_hash_rejects_corruption();
}

test g2_packing_reproduces_bin_words {
    assert g2_packing_matches_bins();
}

test g3_memory_byte_order_is_little_endian {
    assert g3_byte_order_little_endian();
}

test g4_grid_dim_and_bounds_semantics {
    assert g4_grid_bounds();
}

test g5_base_alignment_gates {
    assert g5_alignment();
}

test g6_mock_run_matches_expected_and_respects_bounds {
    assert g6_mock_exec_and_g7_compare();
}

test g7_comparator_catches_one_bit_flip {
    assert g7_comparator_detects_flip();
}

test harness_verdict_pass_only_when_all_gates_ok {
    assert harness_all_gates();
}
